# Postgres with the pgvector extension available (Neon and Supabase both have it).
# Neon: use the pooled connection string. Supabase: use the Session pooler string (port 5432).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Only for `npm test`: a separate database, with pgvector, that the tests truncate.
DATABASE_URL_TEST="postgresql://localhost:5432/docchat_test"

JWT_SECRET="at-least-24-random-characters"
# Comma-separated browser origins allowed to call the API.
WEB_ORIGIN="http://localhost:3200"

# Primary provider: groq or gemini. The other is the fallback when its key is set.
# Groq leads on free tiers: it allows 8k tokens a minute, while Gemini's free tier allows
# only 20 requests a day for gemini-3.6-flash. The lite model below has a larger allowance.
LLM_PROVIDER="groq"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Retrieval
SIMILARITY_THRESHOLD=0.6
TOP_K=5
CHUNK_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Accounts created by `npm run seed` (and on boot with SEED_ON_BOOT=true)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-please"
DEMO_EMAIL="demo@docchat.dev"
DEMO_PASSWORD="docchat-demo"
SEED_ON_BOOT=false

# Optional
# LLM_CACHE=off
# MODEL_CACHE_DIR=.model-cache
